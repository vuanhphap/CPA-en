# Cloudflare Pages — header cấu hình.
#
# Cloudflare Pages KHÔNG đọc vercel.json. Nếu thiếu tệp này, bản deploy trên
# Cloudflare sẽ chạy hoàn toàn không có CSP và không có chính sách cache — nghĩa là
# mọi biện pháp bảo mật trong vercel.json lặng lẽ biến mất mà không có cảnh báo nào.
#
# Nội dung phải khớp vercel.json. qa/test_design.js có test đối chiếu hai tệp; sửa
# một bên mà quên bên kia thì test đỏ.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Corpus bất biến theo phiên bản: cache vĩnh viễn.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# Font cũng bất biến (tên tệp gắn với bộ chữ và độ đậm).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# SDK gắn số phiên bản trong tên tệp nên cũng bất biến.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Mã ứng dụng: luôn kiểm tra lại, nếu không người dùng kẹt bản cũ sau mỗi lần deploy.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/config.js
  Cache-Control: public, max-age=0, must-revalidate

/theme.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
