# Chỉ cần khi muốn tách config khỏi repo trên Vercel (xem DEPLOYMENT.md mục 3.2).
# Không bắt buộc: anon key là khoá công khai theo thiết kế, RLS mới là thứ bảo vệ dữ liệu.
# TUYỆT ĐỐI không đặt SUPABASE_SERVICE_ROLE_KEY ở bất kỳ đâu trong repo này.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
OAUTH_PROVIDERS=google,github
